# normalise line endings: text files use LF in the repository
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.sh text eol=lf
*.jar binary
*.msav binary
*.png binary

# keep GitHub's language bar about the mod itself: the helper scripts and the local
# deployment templates are infrastructure, not part of the Java plugin
deploy/** linguist-vendored
*.ps1 linguist-vendored
* linguist-generated=false
