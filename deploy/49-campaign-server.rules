// Let the colorgarden user manage the campaign server units without interactive authentication.
// Root can always do this; the point here is that ./server.sh restart keeps working as colorgarden.
polkit.addRule(function(action, subject) {
    if (subject.user != "colorgarden") return polkit.Result.NOT_HANDLED;

    if (action.id != "org.freedesktop.systemd1.manage-units" &&
        action.id != "org.freedesktop.systemd1.manage-unit-files") {
        return polkit.Result.NOT_HANDLED;
    }

    var unit = action.lookup("unit");
    if (unit == "campaign-server.service" || unit == "campaign-backup.service") {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
